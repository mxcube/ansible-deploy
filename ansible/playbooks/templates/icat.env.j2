ICAT_PLUS_PORT={{ icat_config.icat_plus_port }}

ICAT_PORT={{ icat_config.icat_port }}
ICAT_PORT_CONSOLE_ADMIN={{ icat_config.icat_port_console_admin }}
ICAT_VERSION={{ icat_config.icat_version }}

